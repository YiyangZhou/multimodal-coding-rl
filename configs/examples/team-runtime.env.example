# Copy outside the checkout; chmod 600 before entering credentials.
# Fill every required value. This file intentionally contains no working credentials.
OPENSANDBOX_DOMAIN=https://YOUR_ASSIGNED_ENDPOINT
OPENSANDBOX_API_KEY=
MMRL_SANDBOX_IMAGE=YOUR_REGISTRY/YOUR_IMAGE@sha256:YOUR_COMPLETE_DIGEST
OPENAI_API_KEYS=
WANDB_API_KEY=
# Must match the selected W&B service; entity/project are set in the recipe.
WANDB_BASE_URL=https://YOUR_WANDB_SERVICE
NEMO_RL_ROOT=/YOUR/PINNED/NEMO_RL
NEMO_GYM_ROOT=/YOUR/PINNED/NEMO_GYM
# Private image only: host must match MMRL_SANDBOX_IMAGE; prefer pull-only access.
REGISTRY_HOST=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
# Harness capture: generate your own gateway token and CA with create_capture_ca.py.
MMRL_CAPTURE_GATEWAY_TOKEN=
MMRL_CAPTURE_CA_CERT=/YOUR/PRIVATE/capture-ca.crt
MMRL_CAPTURE_CA_KEY=/YOUR/PRIVATE/capture-ca.key

# OpenAI-compatible Responses API with structured image scoring.
OPENAI_BASE_URL=https://api.openai.com/v1
MMRL_JUDGE_MODEL=YOUR_VISION_JUDGE_MODEL

# Gym implementation and patches are external, never bundled in this repository.
MMRL_EXTERNAL_GYM_PATCH_DIR=/YOUR/EXTERNAL/GYM_VERIFICATION_MANIFESTS
