+"""Guard the opt-in, per-DP forward materialization layout."""
+
+
+def validate_local_padding_config(config):
+    """Validate before allocating a model; collective counts must stay equal."""
+    dtensor = config["dtensor_cfg"]
+    enabled = dtensor.get("local_forward_padding")
+    if enabled is not None and type(enabled) is not bool:
+        raise ValueError("local_forward_padding must be boolean or null")
+    if not enabled:
+        return
+    if (dtensor["tensor_parallel_size"] != 1
+            or dtensor["context_parallel_size"] != 1
+            or dtensor.get("dp_replicate_size") not in (None, 1)
+            or config["sequence_packing"]["enabled"]
+            or config["dynamic_batching"]["enabled"]
+            or config["train_micro_batch_size"] != 1
+            or config["logprob_batch_size"] != 1):
+        raise ValueError("Local forward padding requires TP1/CP1, unreplicated FSDP, unpacked fixed microbatch size 1")
+    if not dtensor.get("linear_logprob_chunk_size"):
+        raise ValueError("Local forward padding requires the verified linear-logprob path")
