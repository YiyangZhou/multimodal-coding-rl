+"""Exact inverse of the actual capture producer, including distinct image sizes."""
+
+import unittest
+from unittest.mock import patch
+
+import torch
+
+from nemo_rl.data.captured_media import pack_images
+from nemo_rl.models.automodel.captured_images import unpack_captured_images
+
+
+class CapturedImagesTest(unittest.TestCase):
+    def test_exact_pixels_order_dtype_and_padding(self):
+        for dtype in (torch.float32, torch.bfloat16, torch.float16):
+            with self.subTest(dtype=dtype):
+                # Sentinel padding must never become part of another image.
+                pixels = torch.full((3, 3, 48, 64), -999, dtype=dtype)
+                sizes = torch.tensor([[32, 64], [48, 16], [16, 32]], dtype=torch.int32)
+                for i, (h, w) in enumerate(sizes.tolist()):
+                    pixels[i, :, :h, :w] = (
+                        (torch.arange(3 * h * w).reshape(3, h, w) % 251) + i
+                    ).to(dtype)
+                packed = pack_images(pixels, sizes, patch_size=16)[0]
+                restored = unpack_captured_images(packed, sizes)
+                self.assertEqual(restored.dtype, dtype)
+                for i, (h, w) in enumerate(sizes.tolist()):
+                    self.assertTrue(
+                        torch.equal(restored[i, :, :h, :w], pixels[i, :, :h, :w])
+                    )
+                    self.assertEqual(restored[i, :, h:, :].count_nonzero().item(), 0)
+                    self.assertEqual(restored[i, :, :, w:].count_nonzero().item(), 0)
+                self.assertTrue(
+                    torch.equal(pack_images(restored, sizes, patch_size=16)[0], packed)
+                )
+
+    def test_missing_extra_or_malformed_geometry_rejected(self):
+        patches = torch.zeros((4, 768))
+        for sizes in (
+            torch.tensor([[16, 16]]),
+            torch.tensor([[64, 64]]),
+            torch.tensor([[31, 32]]),
+            torch.tensor([[0, 32]]),
+            torch.tensor([[32.0, 32.0]]),
+            torch.zeros((0, 2), dtype=torch.int32),
+        ):
+            with self.subTest(sizes=sizes):
+                with self.assertRaises(ValueError):
+                    unpack_captured_images(patches, sizes)
+
+    def test_bad_pixel_layout_rejected(self):
+        sizes = torch.tensor([[32, 32]])
+        for pixels in (
+            torch.zeros((1, 4, 768)),
+            torch.zeros((4, 769)),
+            torch.zeros((4, 768), dtype=torch.int32),
+        ):
+            with self.subTest(shape=pixels.shape):
+                with self.assertRaises(ValueError):
+                    unpack_captured_images(pixels, sizes)
+
+    def test_native_microbatch_preserves_token_ids_and_restores_images(self):
+        from nemo_rl.data.multimodal_utils import PackedTensor
+        from nemo_rl.distributed.batched_data_dict import BatchedDataDict
+        from nemo_rl.models.automodel.data import process_microbatch
+
+        pixels = torch.arange(2 * 3 * 32 * 48).reshape(2, 3, 32, 48).float()
+        sizes = torch.tensor([[32, 48], [16, 32]], dtype=torch.int32)
+        packed = pack_images(pixels, sizes, patch_size=16)[0]
+        ids = torch.tensor([[10, 11, 12, 13, 14]])
+        batch = BatchedDataDict(
+            {
+                "input_ids": ids,
+                "media_token_validity_mask": torch.tensor(
+                    [[False, True, True, False, False]]
+                ),
+                "pixel_values": PackedTensor([packed], dim_to_pack=0),
+                "imgs_sizes": PackedTensor([sizes], dim_to_pack=0),
+                "num_frames": PackedTensor(
+                    [torch.ones(2, dtype=torch.int32)], dim_to_pack=0
+                ),
+            }
+        )
+        # CPU boundary test only; actual CUDA forward/logprobs are a separate gate.
+        with patch.object(torch.Tensor, "cuda", lambda value: value):
+            result = process_microbatch(
+                batch, None, False, {"dtensor_cfg": {"sequence_parallel": False}}
+            )
+        self.assertTrue(torch.equal(result.input_ids, ids))
+        self.assertTrue(
+            torch.equal(
+                result.vlm_kwargs["media_token_validity_mask"],
+                batch["media_token_validity_mask"],
+            )
+        )
+        self.assertTrue(torch.equal(result.vlm_kwargs["imgs_sizes"], sizes))
+        for i, (h, w) in enumerate(sizes.tolist()):
+            self.assertTrue(
+                torch.equal(
+                    result.vlm_kwargs["pixel_values"][i, :, :h, :w],
+                    pixels[i, :, :h, :w],
+                )
