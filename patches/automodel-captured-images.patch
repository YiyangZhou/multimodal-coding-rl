+def captured_media_token_mask(
+    token_ids: list[int], items: list[CapturedMediaItem]
+) -> torch.Tensor:
+    """Return exact captured image/video embedding positions, including text gaps.
+
+    Args:
+        token_ids: Complete canonical token sequence, without re-tokenization.
+        items: Ordered media occurrences with absolute canonical offsets.
+
+    Returns:
+        New CPU bool tensor [sequence_length]. Only committed embedding spans
+        are true; literal media-token IDs elsewhere remain text.
+    """
+    mask = torch.zeros(len(token_ids), dtype=torch.bool)
+    previous_end = 0
+    for item in items:
+        if item.placeholder_offset < previous_end:
+            raise MediaCaptureRejected(
+                "Captured media placeholders overlap or are out of order"
+            )
+        item.verify_tokens(token_ids, origin=0)
+        for offset, length in item.embedding_spans:
+            mask[offset : offset + length] = True
+        previous_end = item.end
+    return mask


