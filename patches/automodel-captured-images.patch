+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Isolated grouped-FFN memory prototype; not installed into AutoModel."""
+
+from collections.abc import Callable
+
+import torch
+from torch.utils.checkpoint import checkpoint
+
+
+def chunked_experts_forward(
+    hidden_states: torch.Tensor,
+    up_weights: torch.Tensor,
+    down_weights: torch.Tensor,
+    tokens_per_expert: torch.Tensor,
+    routing_probs: torch.Tensor,
+    *,
+    grouped_mm: Callable,
+    activation_fn: Callable,
+    max_chunk_rows: int,
+) -> torch.Tensor:
+    """Compute the same sorted expert rows with bounded intermediate FFNs.
+
+    Args:
+        hidden_states: Expert-sorted routed rows [N, hidden].
+        up_weights: Per-expert weights [E, hidden, intermediate].
+        down_weights: Per-expert weights [E, intermediate, hidden].
+        tokens_per_expert: Row counts [E], including empty experts.
+        routing_probs: Differentiable probabilities [N, 1].
+        grouped_mm: Native grouped GEMM, accepting (rows, weights, offsets).
+        activation_fn: The original weighted activation without modification.
+        max_chunk_rows: Positive maximum routed rows per grouped FFN.
+
+    Returns:
+        Expert-sorted outputs [N, hidden]. No routing, precision, parameter
+        layout, collective or loss changes. Checkpointing recomputes only local
+        FFNs; distributed wrappers remain outside this function.
+    """
+    if max_chunk_rows <= 0:
+        raise ValueError("max_chunk_rows must be positive")
+    offsets = tokens_per_expert.cumsum(0).to(torch.int32)
+
+    def run_chunk(hidden, up, down, probs, local_offsets):
+        projected = grouped_mm(hidden, up, local_offsets)
+        activated = activation_fn(projected, probs)
+        return grouped_mm(activated, down, local_offsets)
+
+    if hidden_states.shape[0] <= max_chunk_rows:
+        return run_chunk(hidden_states, up_weights, down_weights, routing_probs, offsets)
+    outputs = []
+    for start in range(0, hidden_states.shape[0], max_chunk_rows):
+        end = min(start + max_chunk_rows, hidden_states.shape[0])
+        local_offsets = (offsets - start).clamp(0, end - start)
+        args = (hidden_states[start:end], up_weights, down_weights,
+                routing_probs[start:end], local_offsets)
+        if torch.is_grad_enabled():
+            outputs.append(checkpoint(run_chunk, *args, use_reentrant=False))
+        else:
+            outputs.append(run_chunk(*args))
+    return torch.cat(outputs, dim=0)
