+async def _harness_http_wire(masked: bool) -> dict:
+    # Gym is optional in the native policy environment; import it only for HTTP tests.
+    from nemo_gym.config_types import ModelServerRef, ResourcesServerRef
+    from nemo_gym.openai_utils import NeMoGymResponse
+    from nemo_gym.server_utils import ServerClient
+    from responses_api_agents.harness_agent.app import HarnessAgent, HarnessAgentConfig
+
+    config = HarnessAgentConfig(
+        host="127.0.0.1",
+        port=18000,
+        entrypoint="",
+        name="mask_probe",
+        resources_server=ResourcesServerRef(type="resources_servers", name="rs"),
+        model_server=ModelServerRef(type="responses_api_models", name="model"),
+        agent="opencode",
+        sandbox_provider={"opensandbox": {}},
+    )
+    client = MagicMock(spec=ServerClient)
+    client.global_config_dict = {}
+    client.post = AsyncMock(return_value=MagicMock(cookies={}))
+    with (
+        patch("responses_api_agents.harness_agent.app.create_provider"),
+        patch.object(HarnessAgent, "_build_gym_tar", return_value=None),
+    ):
+        agent = HarnessAgent(config=config, server_client=client)
+    app = agent.setup_webserver()
+    row = {"responses_create_params": {"input": "mask probe"}}
+    response = NeMoGymResponse(
+        id="response-probe",
+        created_at=0,
+        model="policy",
+        object="response",
+        output=[],
+        parallel_tool_calls=False,
+        tool_choice="none",
+        tools=[],
+    )
+    verified = row | {
+        "response": response.model_dump(mode="json"),
+        "reward": 0.0,
+        "mask_sample": masked,
+        "instance_config": {"mask_sample": masked},
+    }
+    with (
+        patch.object(HarnessAgent, "responses", new=AsyncMock(return_value=response)),
+        patch(
+            "responses_api_agents.harness_agent.app.raise_for_status", new=AsyncMock()
+        ),
+        patch(
+            "responses_api_agents.harness_agent.app.get_response_json",
+            new=AsyncMock(side_effect=[{}, verified]),
+        ),
+    ):
+        async with httpx.AsyncClient(
+            transport=httpx.ASGITransport(app=app), base_url="http://test"
+        ) as http:
+            result = await http.post("/run", json=row)
+            assert result.status_code == 200, result.text
+            wire = result.json()
+            assert wire["mask_sample"] is masked
+            return wire
+
