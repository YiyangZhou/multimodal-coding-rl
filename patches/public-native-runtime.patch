+@dataclass(frozen=True)
+class LiteralImageShield:
+    """Request-local rendering copies; the tokenizer and source stay unchanged."""
+
+    messages: list[dict[str, Any]]
+    tools: list[dict[str, Any]] | None
+    marker: str
+    marker_id: int
+    image_id: int
+
+    def restore_tokens(self, tokens: list[int]) -> list[int]:
+        """Restore literal tokens one-for-one, preserving placeholder offsets."""
+        return [self.image_id if token == self.marker_id else token for token in tokens]
+
+    def restore_text(self, value: Any) -> Any:
+        """Restore diagnostic conversation text without changing media payloads."""
+        return _replace_strings(value, self.marker, "<image>")
+
+
+def _replace_strings(value: Any, source: str, target: str) -> Any:
+    if isinstance(value, str):
+        return value.replace(source, target)
+    if isinstance(value, list):
+        return [_replace_strings(item, source, target) for item in value]
+    if isinstance(value, dict):
+        return {
+            key.replace(source, target): _replace_strings(item, source, target)
+            for key, item in value.items()
+        }
+    return value
+
+
+def shield_literal_image_markers(
+    *,
+    messages: list[dict[str, Any]],
+    tools: list[dict[str, Any]] | None,
+    tokenizer: Any,
+    chat_template: str,
+) -> LiteralImageShield | None:
+    """Protect pure-text markers while the native processor locates images.
+
+    Structured media messages retain their explicit placement convention.
+    Only a collision-free, existing Omni reserved token with identical lexical
+    flags can be used. It is restored before capture and engine execution;
+    no vocabulary change, token deletion or image substitution is performed.
+    """
+    media_types = {"image", "image_url", "input_image", "video", "video_url", "input_video"}
+    media_messages = {
+        i for i, message in enumerate(messages)
+        if isinstance(message.get("content"), list)
+        and any(part.get("type") in media_types for part in message["content"])
+    }
+    if not media_messages:
+        return None
+    literals = [message for i, message in enumerate(messages) if i not in media_messages]
+    if "<image>" not in json.dumps([literals, tools], ensure_ascii=False):
+        return None
+    image_ids = tokenizer.encode("<image>", add_special_tokens=False)
+    if len(image_ids) != 1:
+        raise MediaCaptureRejected("Literal image shielding requires one image token")
+    image_id = image_ids[0]
+    added = tokenizer.added_tokens_decoder
+    image_token = added.get(image_id)
+    if image_token is None:
+        raise MediaCaptureRejected("Literal image token has no lexical metadata")
+    occupied = json.dumps([messages, tools], ensure_ascii=False) + chat_template
+    flags = ("single_word", "lstrip", "rstrip", "normalized", "special")
+    marker = None
+    marker_id = None
+    for candidate_id, candidate in sorted(added.items()):
+        text = candidate.content
+        if not re.fullmatch(r"<SPECIAL_\d+>", text) or text in occupied:
+            continue
+        if any(getattr(candidate, flag) != getattr(image_token, flag) for flag in flags):
+            continue
+        if tokenizer.encode(text, add_special_tokens=False) != [candidate_id]:
+            continue
+        marker, marker_id = text, candidate_id
+        break
+    if marker is None or marker_id is None:
+        raise MediaCaptureRejected("No collision-free literal image shielding token")
+    safe_messages = [
+        deepcopy(message) if i in media_messages else _replace_strings(message, "<image>", marker)
+        for i, message in enumerate(messages)
+    ]
+    return LiteralImageShield(
+        safe_messages, _replace_strings(tools, "<image>", marker), marker, marker_id, image_id
+    )
