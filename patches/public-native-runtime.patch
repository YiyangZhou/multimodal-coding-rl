+async def _commit_snapshot_before_cancellation(function, *args, **kwargs):
+    """Join a filesystem commit thread before cancellation triggers cleanup."""
+    pending = asyncio.create_task(asyncio.to_thread(function, *args, **kwargs))
+    try:
+        return await asyncio.shield(pending)
+    except asyncio.CancelledError:
+        # Cancelling an await cannot stop the filesystem thread. Let its rename
+        # finish before the caller removes temporary state, preserving cancellation.
+        await asyncio.gather(pending, return_exceptions=True)
+        raise
