+"""Literal media text must never consume a structured image occurrence."""
+
+from copy import deepcopy
+
+import pytest
+from tokenizers import AddedToken, Tokenizer, models
+from transformers import PreTrainedTokenizerFast
+
+from nemo_rl.data.captured_media import MediaCaptureRejected
+from nemo_rl.data.literal_media import shield_literal_image_markers
+
+
+def tokenizer(reserved=True):
+    backend = Tokenizer(models.WordLevel({"[UNK]": 0}, unk_token="[UNK]"))
+    special = ["<image>"] + (["<SPECIAL_30>", "<SPECIAL_31>"] if reserved else [])
+    return PreTrainedTokenizerFast(tokenizer_object=backend, unk_token="[UNK]",
+        additional_special_tokens=[AddedToken(t, special=True, normalized=False) for t in special])
+
+
+def messages():
+    return [{"role":"user", "content":[{"type":"image_url", "image_url":{"url":"data:image/png;base64,AAAA"}}]},
+        {"role":"assistant", "content":"A literal <image> in code.",
+         "tool_calls":[{"function":{"name":"write_file", "arguments":'{"text":"<image>"}'}}]}]
+
+
+def test_restore_exact_text_tokens_and_leave_source_and_media_untouched():
+    tok = tokenizer()
+    source = messages()
+    before = deepcopy(source)
+    tools = [{"type":"function", "function":{"name":"render", "description":"Use <image> literally"}}]
+    result = shield_literal_image_markers(messages=source, tools=tools, tokenizer=tok, chat_template="")
+    assert result is not None and source == before
+    assert result.messages[0] == source[0]
+    assert result.restore_text(result.messages) == source
+    assert result.restore_text(result.tools) == tools
+    text = source[1]["content"]
+    assert result.restore_tokens(tok.encode(result.messages[1]["content"],add_special_tokens=False)) == tok.encode(text,add_special_tokens=False)
+
+
+def test_reserved_token_collision_uses_another_existing_token():
+    tok = tokenizer()
+    result = shield_literal_image_markers(messages=messages(),tools=None,tokenizer=tok,chat_template="<SPECIAL_30>")
+    assert result is not None and result.marker == "<SPECIAL_31>"
+
+
+@pytest.mark.parametrize("reserved,template", [(False,""),(True,"<SPECIAL_30><SPECIAL_31>")])
+def test_no_safe_marker_rejects_instead_of_changing_tokens(reserved, template):
+    with pytest.raises(MediaCaptureRejected,match="No collision-free"):
+        shield_literal_image_markers(messages=messages(),tools=None,tokenizer=tokenizer(reserved),chat_template=template)
+
+
+def test_text_only_request_does_not_require_a_reserved_token():
+    assert shield_literal_image_markers(messages=[{"role":"user","content":"<image>"}],
+        tools=None,tokenizer=tokenizer(False),chat_template="") is None
+
+
+def test_explicit_image_placement_stays_unchanged():
+    source=[{"role":"user","content":[{"type":"text","text":"<image>"},
+        {"type":"image_url","image_url":{"url":"data:image/png;base64,AAAA"}}]}]
+    before=deepcopy(source)
+    assert shield_literal_image_markers(messages=source,tools=None,tokenizer=tokenizer(False),chat_template="") is None
+    assert source==before
