+@pytest.mark.parametrize("receipt", [True, False])
+@pytest.mark.parametrize("gate", [True, False])
+def test_http_mask_reaches_completion_with_explicit_gate(receipt, gate):
+    wire = asyncio.run(_harness_http_wire(True))
+    result = (
+        manager_tests._mask_gate_receipt_result()
+        if receipt
+        else manager_tests._mask_gate_result()
+    )
+    result["full_result"] = wire
+    completion = manager_tests._nemo_gym_impl(gate)._results_to_completions([result])[
+        0
+    ][0]
+    assert _mask_sample_flag(completion.env_extras) is gate
