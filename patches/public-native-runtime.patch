+def validate_captured_image_policy(
+    policy: "PolicyConfig", model_config: "PretrainedConfig"
+) -> None:
+    """Validate the native Omni learner configuration for captured still images.
+
+    This checks configuration capability, not numerical parity or runtime
+    acceptance. Video remains rejected at the image conversion boundary.
+
+    Args:
+        policy: Resolved policy configuration with explicit parallelism settings.
+        model_config: Loaded HF configuration after applying policy overrides.
+    """
+    dtensor = policy["dtensor_cfg"]
+    if not dtensor["enabled"] or policy["megatron_cfg"]["enabled"]:
+        raise ValueError("Captured image adaptation requires the Automodel learner")
+    kwargs = dtensor.get("automodel_kwargs")
+    if kwargs is None or kwargs.get("force_hf") is not False:
+        raise ValueError(
+            "Automodel image capture requires explicit automodel_kwargs.force_hf=false"
+        )
+    if model_config.architectures != ["NemotronH_Nano_Omni_Reasoning_V3"]:
+        raise ValueError(
+            "Automodel image capture is implemented only for native Nemotron Omni V3"
+        )
+    if policy["sequence_packing"]["enabled"] or dtensor["sequence_parallel"]:
+        raise ValueError(
+            "Automodel image capture does not support sequence packing or sequence parallelism"
+        )
+    if dtensor["tensor_parallel_size"] != 1 or dtensor["context_parallel_size"] != 1:
+        raise ValueError(
+            "Automodel image capture currently requires learner TP1 and CP1"
+        )
+
+
+def unpack_captured_images(patches: torch.Tensor, sizes: torch.Tensor) -> torch.Tensor:
+    """Invert capture's spatial patch permutation without resizing or recasting.
+
+    Capture stores each image in raster patch order with channel-major pixels
+    inside each patch. Automodel's dynamic RADIO path consumes BCHW and crops
+    padding using ``imgs_sizes``. Keep each image's original geometry and order;
+    pad only the final dense batch, never the captured patch sequence.
+    """
+    if patches.ndim != 2 or not patches.is_floating_point():
+        raise ValueError(
+            "Captured image patches must be a floating [patches, features] tensor"
+        )
+    if sizes.ndim != 2 or sizes.shape[1] != 2 or sizes.shape[0] == 0:
+        raise ValueError("Captured image sizes must be nonempty [images, 2]")
+    if sizes.dtype not in (torch.int32, torch.int64):
+        raise ValueError("Captured image sizes must be integer geometry")
+    features = patches.shape[1]
+    patch_size = isqrt(features // 3)
+    if patch_size < 1 or 3 * patch_size**2 != features:
+        raise ValueError("Captured image patch width must equal 3 * patch_size**2")
+    geometry = sizes.tolist()
+    if any(h <= 0 or w <= 0 or h % patch_size or w % patch_size for h, w in geometry):
