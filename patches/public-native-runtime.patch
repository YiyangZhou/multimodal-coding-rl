+"""Host-issued, immutable per-attempt opt-in. Isolated; not deployed.
+
+Only the trusted rollout issuer may register a newly minted attempt. Neither
+model messages nor sandbox HTTP headers are authorization to register one.
+The registry must be outside the sandbox's mounted/writable filesystem.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import tempfile
+
+
+def _path(root, attempt):
+    if not isinstance(attempt, str) or not attempt:
+        raise ValueError("Nonempty attempt identity required")
+    root = Path(root)
+    if not root.is_absolute():
+        raise ValueError("Absolute host registry path required")
+    return root / (hashlib.sha256(attempt.encode()).hexdigest() + '.json')
+
+
+def register_new_attempt(root, attempt, *, harness):
+    """Call exactly once, at trusted attempt creation, before any dispatch.
+
+    Old/restored attempts must not call this method. Duplicate registration is
+    an error, including the same harness: retries belong to the existing attempt.
+    Registration itself does not prove that the caller minted a fresh identity.
+    """
+    if harness != 'opencode':
+        return False
+    target = _path(root, attempt)
+    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    value = {'schema': 1, 'attempt': attempt, 'harness': harness}
+    fd, temp = tempfile.mkstemp(prefix='.activation-', dir=target.parent)
+    try:
+        with os.fdopen(fd, 'w') as handle:
+            json.dump(value, handle)
+            handle.flush()
+            os.fsync(handle.fileno())
+        # Atomic publication without replacing an existing scope decision.
+        os.link(temp, target)
+        directory = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+    finally:
+        os.unlink(temp)
+    return True
+
+
+def is_enabled(root, attempt):
+    """Read a host decision; absent means leave the original capture path alone."""
+    target = _path(root, attempt)
+    try:
+        fd = os.open(target, os.O_RDONLY | os.O_NOFOLLOW)
+    except FileNotFoundError:
+        return False
+    with os.fdopen(fd) as handle:
+        value = json.load(handle)
+    if value != {'schema': 1, 'attempt': attempt, 'harness': 'opencode'}:
+        raise ValueError('Invalid or mismatched activation decision')
+    return True
