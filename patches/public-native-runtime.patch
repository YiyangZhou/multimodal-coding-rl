+"""Opt-in process returns bound after native capture/media verification."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from importlib import import_module
+import math
+from typing import Callable
+
+from pydantic import BaseModel, StrictStr, field_validator
+
+
+class ProcessReturnConfig(BaseModel, extra="forbid"):
+    """Trusted application hooks; absent configuration retains episode rewards."""
+
+    binder: StrictStr
+    advantage: StrictStr
+
+    @field_validator("binder", "advantage")
+    @classmethod
+    def qualified_callable(cls, value: str) -> str:
+        if "." not in value or any(not part.isidentifier() for part in value.split(".")):
+            raise ValueError("Process-return hooks must name a module-qualified callable")
+        return value
+
+
+@dataclass(frozen=True)
+class ProcessReturns:
+    """Canonical sequence returns; prompt/tool positions must contain zero."""
+
+    episode_reward: float
+    token_returns: tuple[float, ...]
+
+    def validate(self, token_mask: list[float]) -> None:
+        if not math.isfinite(self.episode_reward):
+            raise ValueError("Process episode reward must be finite")
+        if len(self.token_returns) != len(token_mask):
+            raise ValueError("Process returns must cover the exact verified sequence")
+        for value, mask in zip(self.token_returns, token_mask, strict=True):
+            if not math.isfinite(value) or (mask == 0 and value != 0):
+                raise ValueError("Process returns must be finite and zero outside assistant spans")
+
+
+def load_process_hook(path: str) -> Callable:
+    """Resolve a callable from trusted run configuration before accepting work."""
+    module, name = path.rsplit(".", 1)
+    hook = getattr(import_module(module), name)
+    if not callable(hook):
+        raise TypeError(f"Configured process hook is not callable: {path}")
+    return hook
