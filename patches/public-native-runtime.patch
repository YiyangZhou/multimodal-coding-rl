+@pytest.mark.parametrize("all_failed", [False, True])
+def test_http_to_receipt_finalization_and_advantage_mask(all_failed):
+    """Real HTTP, ledger, staged token rebuild, row packing and GRPO mask.
+
+    The model/provider are stand-ins and storage uses the native in-process
+    adapter; no claim about distributed transport or GPU numerics is made.
+    """
+    # These optional Gym/capture dependencies are needed only by this integration test.
+    from nemo_rl.data_plane.adapters.noop import NoOpDataPlaneClient
+    from nemo_rl.data_plane.tq_token_sink import STAGING_FIELDS, TQTokenSink
+    from nemo_rl.experience.rollout_reassembler import RolloutReassembler
+    from nemo_rl.algorithms.single_controller_utils.advantage_stage import (
+        AdvantageRequest,
+    )
+    from tests.unit.data_plane.token_capture_test_fixtures import (
+        build_fixture_artifacts,
+    )
+    from tests.unit.single_controller.test_advantage_stage import _controller
+
+    wires = [asyncio.run(_harness_http_wire(flag)) for flag in (True, False)]
+    masks = [True] * 8 if all_failed else [True] * 6 + [False, False]
+    dp = NoOpDataPlaneClient()
+    dp.register_partition(
+        partition_id="mask_staging",
+        fields=list(STAGING_FIELDS),
+        num_samples=128,
+        consumer_tasks=["finalize"],
+    )
+    fields = [
+        "input_ids",
+        "input_lengths",
+        "generation_logprobs",
+        "token_mask",
+        "sample_mask",
+        "prompt_ids_for_adv",
+        "total_reward",
+        "mask_sample",
+        "truncated",
+        "advantages",
+    ]
+    dp.register_partition(
+        partition_id="mask_rows",
+        fields=fields,
+        num_samples=32,
+        consumer_tasks=["train"],
+    )
+    sink = TQTokenSink(dp, staging_partition="mask_staging")
+    original = manager_tests._receipt_record
+
+    def make_record(ids, ignored_receipts, **kwargs):
+        receipts = []
+        for rid in ids:
+            records, receipt, _ = build_fixture_artifacts(
+                "worked_example", rollout_id=rid
+            )
+            for record in records:
+                assert sink.stage(record).ok
+            receipts.append(receipt.model_dump())
+        record = original(ids, receipts, **kwargs)
+        for i, completion in enumerate(record.completions):
+            completion.env_extras.update(wires[0 if masks[i] else 1])
+            # Masked failures must not influence the valid siblings' baseline.
+            completion.reward = 100.0 if masks[i] else (0.2 if i == 6 else 0.8)
+        return record
+
+    manager = manager_tests._make_capture_manager(
+        manager_tests._FakeCaptureBuffer(), num_generations=8
+    )
+    with patch.object(manager_tests, "_receipt_record", side_effect=make_record):
+        request = asyncio.run(
+            manager.generate_for_finalization({"prompt": "p", "idx": 0})
+        )
+    assert list(request.mask_sample) == masks
+    finalizer = RolloutReassembler(
+        dp,
+        partition_id="mask_rows",
+        staging_partition="mask_staging",
+        pad_token_id=0,
+        max_seq_len=4096,
+    )
+    finalized = finalizer.finalize_group(
+        request.group_id,
+        list(request.rollout_ids),
+        list(request.receipts),
+        list(request.rewards),
+        mask_sample=list(request.mask_sample),
+        fallback_weight_version=request.fallback_weight_version,
+        prompt_idx=request.prompt_idx,
+        canonical_sample_ids=list(request.canonical_sample_ids),
+    )
+    assert finalized.valid_row_count == 8
+    computer = _controller("grpo", 0, dp)._advantage_computer
+    outcome = asyncio.run(computer.run(AdvantageRequest(meta=finalized.meta)))
+    assert outcome.num_mask_sample_filtered == sum(masks)
+    assert outcome.has_valid_training_tokens is (not all_failed)
+    rows = dp.get_samples(
+        sample_ids=finalized.meta.sample_ids,
+        partition_id="mask_rows",
+        select_fields=["sample_mask", "token_mask", "advantages"],
+    )
+    assert torch.as_tensor(rows["sample_mask"]).flatten().tolist() == [
+        float(not x) for x in masks
+    ]
+    for i, masked in enumerate(masks):
+        if masked:
+            # GRPO can retain raw advantages on excluded rows. The learner
+            # multiplies them by token and sample masks before computing loss.
+            effective = (
+                rows["advantages"][i] * rows["token_mask"][i] * rows["sample_mask"][i]
+            )
+            assert torch.count_nonzero(effective).item() == 0
+    if not all_failed:
+        assert rows["advantages"][6].sum() < 0 < rows["advantages"][7].sum()
