+"""Bounded quality-relative length shaping for single-turn captured GRPO.
+
+Raw reward columns remain immutable so checkpoint replay cannot compound the
+penalty. Call immediately before advantage computation, after sample masking.
+"""
+from typing import Literal
+from pydantic import BaseModel, Field, model_validator
+
+
+class LengthPenaltyConfig(BaseModel, extra="forbid"):
+    mode: Literal["fixed_total", "relative_thinking"] = "fixed_total"
+    quality_reward_floor: float = Field(default=0.72, ge=0.2, le=1)
+    comparison_atol: float = Field(default=1e-6, ge=0, le=1e-4)
+    near_best_reward_gap: float = Field(default=0.04, ge=0, le=0.1)
+    min_reference_samples: int = Field(default=3, ge=2, strict=True)
+    group_size: int = Field(default=16, ge=2, strict=True)
+    thinking_start_token_id: int = Field(default=12, ge=0, strict=True)
+    thinking_end_token_id: int = Field(default=13, ge=0, strict=True)
+    grace_tokens: int = Field(default=16384, ge=0, strict=True)
+    cap_tokens: int = Field(default=32768, gt=0, strict=True)
+    max_fraction: float = Field(default=0.03, ge=0, le=0.1)
+
+    @model_validator(mode="after")
+    def ordered_limits(self):
+        if self.cap_tokens <= self.grace_tokens:
+            raise ValueError("Length penalty cap must exceed grace length")
+        return self
+
+
+def shape_rewards(raw_rewards, token_mask, sample_mask, config, *, token_ids=None, group_ids=None):
+    import torch
+
+    if raw_rewards.ndim != 1 or sample_mask.shape != raw_rewards.shape:
+        raise ValueError("Expected one reward and sample mask per response")
+    if token_mask.ndim != 2 or token_mask.shape[0] != raw_rewards.shape[0]:
+        raise ValueError("Expected token mask with one row per response")
+    if not torch.isfinite(raw_rewards).all():
+        raise ValueError("Nonfinite rewards must not enter advantage computation")
+    if ((raw_rewards < 0) | (raw_rewards > 1)).any():
+        raise ValueError("Length shaping expects execution/quality rewards in [0, 1]")
+    if not ((token_mask == 0) | (token_mask == 1)).all():
+        raise ValueError("Generation token mask must be binary")
+    # Native capture marks only assistant-generated tokens, including thinking;
+    # input images, prompts, padding and tool observations have mask zero.
+    lengths = token_mask.sum(dim=-1)
+    if config.mode == "relative_thinking":
+        if token_ids is None or token_ids.shape != token_mask.shape or group_ids is None:
+            raise ValueError("Relative thinking shaping requires exact token IDs and rollout group IDs")
+        if len(group_ids) != len(raw_rewards):
+            raise ValueError("Group ID count does not match responses")
+        positions = torch.arange(token_ids.shape[1], device=token_ids.device)[None, :]
+        generated = token_mask.bool()
+        starts = token_ids == config.thinking_start_token_id
+        ends = (token_ids == config.thinking_end_token_id) & generated
+        first_generated = torch.where(generated, positions, token_ids.shape[1]).amin(dim=1)
+        opening = torch.where(starts, positions, token_ids.shape[1]).amin(dim=1)
+        closing = torch.where(ends, positions, token_ids.shape[1]).amin(dim=1)
+        reliable = (starts.sum(dim=1) == 1) & (ends.sum(dim=1) == 1) & (opening < first_generated)
+        thinking = (generated & (positions < closing[:, None])).sum(dim=1).float()
+        penalty = torch.zeros_like(raw_rewards)
+        for gid in dict.fromkeys(group_ids):
+            indexes = [i for i, value in enumerate(group_ids) if value == gid]
+            if len(indexes) != config.group_size:
+                raise ValueError("Relative thinking shaping requires a complete rollout group")
+            idx = torch.tensor(indexes, device=raw_rewards.device)
+            valid = sample_mask[idx] > 0
+            if not valid.any():
+                continue
+            best = raw_rewards[idx][valid].max()
+            reference = valid & reliable[idx] & (raw_rewards[idx] >= config.quality_reward_floor - config.comparison_atol) & (raw_rewards[idx] >= best - config.near_best_reward_gap - config.comparison_atol)
+            if reference.sum() < config.min_reference_samples:
+                continue
+            ref = torch.quantile(thinking[idx][reference], 0.5)
+            if ref <= 0:
+                continue
+            fraction = ((thinking[idx] - ref) / ref).clamp(0, 1)
+            penalty[idx] = raw_rewards[idx] * config.max_fraction * fraction * valid * reliable[idx]
+        return raw_rewards - penalty, penalty, lengths
+    fraction = ((lengths - config.grace_tokens) /
+                (config.cap_tokens - config.grace_tokens)).clamp(0, 1)
+    # Invalid/filtered responses remain excluded and do not get invented scores.
+    penalty = raw_rewards * config.max_fraction * fraction * (sample_mask > 0)
+    return raw_rewards - penalty, penalty, lengths
