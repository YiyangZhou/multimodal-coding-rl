+        await self._maybe_restore_rollout_recovery(restored_replay_groups=restored)
+        await self._maybe_restore_replacement_reserve()
+        self._validate_restored_sampler_cursor()
+        tasks = [asyncio.create_task(self._rollout_pump()),
